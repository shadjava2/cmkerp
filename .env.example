# Copiez ce fichier vers .env dans le même dossier que run-gateway.ps1.
# Renseignez les valeurs sur la machine qui exécute le gateway.
SPRING_PROFILES_ACTIVE=dev

# Base ERP, obligatoire. Remplacez hôte, port, base et identifiants.
CMK_PRIMARY_DB_URL=jdbc:mysql://127.0.0.1:3306/cmkerp_local?useSSL=false&serverTimezone=UTC
CMK_PRIMARY_DB_USER=utilisateur_local
CMK_PRIMARY_DB_PASSWORD=mot_de_passe_local

# Bases optionnelles. Laissez les URL vides si elles ne sont pas utilisées.
CMK_MEDILINE_DB_URL=
CMK_MEDILINE_DB_USER=
CMK_MEDILINE_DB_PASSWORD=

CMK_CLINIQUE_DB_URL=
CMK_CLINIQUE_DB_USER=
CMK_CLINIQUE_DB_PASSWORD=

CMK_CLINIQUE_CH_DB_URL=
CMK_CLINIQUE_CH_DB_USER=
CMK_CLINIQUE_CH_DB_PASSWORD=

# Coexistence CLINIQUE — défauts sûrs (écritures OFF hors autorisation limitée)
CLINIC_BEACH_SYNC_ENABLED=false
CLINIC_BEACH_WRITE_ENABLED=false
CLINIC_BEACH_WRITE_ENTITIES=TCONTRAT
CLINIC_BEACH_INBOUND_ENABLED=false
CLINIC_BEACH_INBOUND_INTERVAL_MS=60000
CLINIC_BEACH_DELETE_ENABLED=false
CLINIC_CH_WRITE_ENABLED=false
CLINIC_BEACH_EXCLUDE_CODES=TES
