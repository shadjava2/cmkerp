# Production. La DB = même serveur que application-dev.yml
# Toujours mettre les valeurs entre quotes (URL JDBC contient des &)
SPRING_PROFILES_ACTIVE=prod
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_HOST_PORT=8999
JAVA_OPTS="-XX:MaxRAMPercentage=75.0"

# --- 1) Primaire ERP (MySQL cmkerp-v24prod) — obligatoire ---
CMK_PRIMARY_DB_URL="jdbc:mysql://192.168.100.254:32768/cmkerp-v24prod?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useCompression=true&useServerPrepStmts=true&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048&rewriteBatchedStatements=true&useLocalSessionState=true&elideSetAutoCommits=true&alwaysSendSetIsolation=false&cacheServerConfiguration=true&cacheResultSetMetadata=true&cacheCallableStmts=true&enableQueryTimeouts=true&useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull&maintainTimeStats=false"
CMK_PRIMARY_DB_USER="cmkroot"
CMK_PRIMARY_DB_PASSWORD="CHANGE_ME"

# --- 2) Mediline (MySQL production) — optionnel ; laisser vide pour démarrer sans ---
# CMK_MEDILINE_DB_URL="jdbc:mysql://192.168.100.254:3310/production?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
# CMK_MEDILINE_DB_USER="dbuser"
# CMK_MEDILINE_DB_PASSWORD="CHANGE_ME"
CMK_MEDILINE_DB_URL=
CMK_MEDILINE_DB_USER=
CMK_MEDILINE_DB_PASSWORD=

# --- 3) CLINIQUE (SQL Server SVR-THALIA\SQLEXPRESS) — optionnel ; lecture seule ---
# Depuis Docker Linux : auth SQL Server (login/mdp), PAS Windows Authentication.
# Créer un login SQL en lecture seule sur la base CLINIQUE.
# CMK_CLINIQUE_DB_URL="jdbc:sqlserver://192.168.100.254;instanceName=SQLEXPRESS;databaseName=CLINIQUE;encrypt=false;trustServerCertificate=true"
# CMK_CLINIQUE_DB_USER="cmk_readonly"
# CMK_CLINIQUE_DB_PASSWORD="CHANGE_ME"
CMK_CLINIQUE_DB_URL=
CMK_CLINIQUE_DB_USER=
CMK_CLINIQUE_DB_PASSWORD=

CMK_JWT_SECRET="ChangeMoi-Tres-Long-ET-Tres-Sale"

MAIL_PASSWORD=""
