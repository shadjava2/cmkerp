<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="fournisseurs"
              language="java"
              pageWidth="842"
              pageHeight="595"
              orientation="Portrait"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Paramètres globaux du rapport -->
    <parameter name="TITRE_RAPPORT" class="java.lang.String"/>
    <parameter name="DATE_GENERATION" class="java.lang.String"/>
    <parameter name="TOTAL_FOURNISSEURS" class="java.lang.Integer"/>

    <!-- Champs pour chaque fournisseur -->
    <field name="id" class="java.lang.Long"/>
    <field name="nom" class="java.lang.String"/>
    <field name="telephone" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="adresse" class="java.lang.String"/>

    <!-- En-tête global du rapport -->
    <title>
        <band height="70" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="802" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTE DES FOURNISSEURS]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="401" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + ($P{DATE_GENERATION} != null ? $P{DATE_GENERATION} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="401" y="28" width="401" height="18"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Total: " + $P{TOTAL_FOURNISSEURS} + " fournisseur(s)"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="802" height="18"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["CMK ERP - Centre Médical de Kinshasa"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- En-têtes des colonnes -->
    <columnHeader>
        <band height="22" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="60" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="220" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Nom]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="150" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Téléphone]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="200" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement x="630" y="0" width="172" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Adresse]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Détails : affiche les fournisseurs -->
    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{id} != null ? $F{id} : ""]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="60" y="0" width="220" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{nom} != null ? $F{nom} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="150" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{telephone} != null ? $F{telephone} : "-"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="430" y="0" width="200" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{email} != null ? $F{email} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="630" y="0" width="172" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{adresse} != null ? $F{adresse} : "-"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Pied de page -->
    <summary>
        <band height="28" splitType="Stretch">
            <textField>
                <reportElement x="0" y="8" width="802" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["CMK ERP - Centre Médical de Kinshasa"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <!-- Message si aucune donnée -->
    <noData>
        <band height="40" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Aucun fournisseur]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>

