<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ventes-list"
              language="java"
              pageWidth="842"
              pageHeight="595"
              orientation="Portrait"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Paramètres globaux du rapport -->
    <parameter name="TITRE_RAPPORT" class="java.lang.String"/>
    <parameter name="PHARMACIE_NOM" class="java.lang.String"/>
    <parameter name="DATE_GENERATION" class="java.lang.String"/>
    <parameter name="TOTAL_VENTES" class="java.lang.Integer"/>

    <!-- Champs pour chaque ligne (structure plate) -->
    <field name="venteId" class="java.lang.Long"/>
    <field name="pharmacieNom" class="java.lang.String"/>
    <field name="statut" class="java.lang.String"/>
    <field name="dateCreation" class="java.lang.String"/>
    <field name="dateValidation" class="java.lang.String"/>
    <field name="raisonSortie" class="java.lang.String"/>
    <field name="demandeur" class="java.lang.String"/>
    <field name="venteTotal" class="java.math.BigDecimal"/>
    <field name="numeroLigne" class="java.lang.Integer"/>
    <field name="produitNom" class="java.lang.String"/>
    <field name="qt" class="java.lang.Float"/>
    <field name="prixventes" class="java.math.BigDecimal"/>
    <field name="totalLigne" class="java.math.BigDecimal"/>

    <!-- Groupe par vente (utilise venteId comme clé) -->
    <group name="venteGroup">
        <groupExpression><![CDATA[$F{venteId}]]></groupExpression>
        <groupHeader>
            <band height="140" splitType="Stretch" isSplitAllowed="true">
                <!-- Séparateur visuel si ce n'est pas le premier -->
                <line>
                    <reportElement x="0" y="0" width="802" height="1" isPrintRepeatedValues="false"/>
                    <graphicElement>
                        <pen lineWidth="1.0" lineColor="#CCCCCC"/>
                    </graphicElement>
                </line>

                <!-- Titre -->
                <staticText>
                    <reportElement x="0" y="8" width="802" height="22"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="16" isBold="true"/>
                    </textElement>
                    <text><![CDATA[SORTIE POUR USAGE]]></text>
                </staticText>

                <!-- Numéro de vente -->
                <textField>
                    <reportElement x="0" y="30" width="802" height="18" isPrintRepeatedValues="false"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="13"/>
                    </textElement>
                    <textFieldExpression><![CDATA["N° " + ($F{venteId} != null ? $F{venteId}.toString() : "")]]></textFieldExpression>
                </textField>

                <!-- Informations Pharmacie -->
                <staticText>
                    <reportElement x="0" y="55" width="401" height="16"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <text><![CDATA[INFORMATIONS PHARMACIE]]></text>
                </staticText>
                <textField>
                    <reportElement x="0" y="71" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Pharmacie: " + ($F{pharmacieNom} != null ? $F{pharmacieNom} : "-")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="0" y="87" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Date création: " + ($F{dateCreation} != null ? $F{dateCreation} : "-")]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="103" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{dateValidation} != null && $F{dateValidation}.length() > 0 ? "Date validation: " + $F{dateValidation} : ""]]></textFieldExpression>
                </textField>

                <!-- Informations Sortie -->
                <staticText>
                    <reportElement x="401" y="55" width="401" height="16"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <text><![CDATA[INFORMATIONS SORTIE]]></text>
                </staticText>
                <textField>
                    <reportElement x="401" y="71" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Statut: " + ($F{statut} != null ? $F{statut} : "-")]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="401" y="87" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{raisonSortie} != null && $F{raisonSortie}.length() > 0 ? "Raison: " + $F{raisonSortie} : ""]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="401" y="103" width="401" height="16" isPrintRepeatedValues="false"/>
                    <box>
                        <pen lineWidth="0.5"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{demandeur} != null && $F{demandeur}.length() > 0 ? "Demandeur: " + $F{demandeur} : ""]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="50" splitType="Stretch">
                <!-- Totaux de cette vente -->
                <line>
                    <reportElement x="0" y="0" width="802" height="1"/>
                    <graphicElement>
                        <pen lineWidth="1.0" lineColor="#CCCCCC"/>
                    </graphicElement>
                </line>
                <textField>
                    <reportElement x="500" y="8" width="140" height="16" isPrintRepeatedValues="false"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total:"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="640" y="8" width="162" height="16" isPrintRepeatedValues="false"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{venteTotal} != null ? $F{venteTotal}.toString() : "0.00"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <!-- En-tête global du rapport -->
    <title>
        <band height="70" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="802" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTE DES SORTIES POUR USAGE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="401" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Pharmacie: " + ($P{PHARMACIE_NOM} != null ? $P{PHARMACIE_NOM} : "Toutes les pharmacies")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="401" y="28" width="401" height="18"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + ($P{DATE_GENERATION} != null ? $P{DATE_GENERATION} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="802" height="18"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Total: " + $P{TOTAL_VENTES} + " sortie(s)"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- En-têtes des colonnes pour les lignes -->
    <columnHeader>
        <band height="22" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="40" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[N°]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="400" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Produit]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="100" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Quantité]]></text>
            </staticText>
            <staticText>
                <reportElement x="540" y="0" width="130" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Prix unitaire]]></text>
            </staticText>
            <staticText>
                <reportElement x="670" y="0" width="132" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Détails : affiche les lignes (masque si numeroLigne = 0, ce qui signifie pas de lignes) -->
    <detail>
        <band height="20" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="40" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} > 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroLigne} != null ? $F{numeroLigne} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="40" y="0" width="400" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} > 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{produitNom} != null ? $F{produitNom} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="440" y="0" width="100" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} > 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{qt} != null ? $F{qt} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="540" y="0" width="130" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} > 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{prixventes} != null ? $F{prixventes}.toString() : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="670" y="0" width="132" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} > 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{totalLigne} != null ? $F{totalLigne}.toString() : ""]]></textFieldExpression>
            </textField>
            <!-- Message si aucune ligne pour cette vente -->
            <staticText>
                <reportElement x="0" y="0" width="802" height="20">
                    <printWhenExpression><![CDATA[$F{numeroLigne} != null && $F{numeroLigne} == 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Aucune ligne pour cette sortie]]></text>
            </staticText>
        </band>
    </detail>

    <!-- Pied de page -->
    <summary>
        <band height="28" splitType="Stretch">
            <textField>
                <reportElement x="0" y="8" width="802" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["CMK ERP - Centre Médical de Kinshasa"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <!-- Message si aucune donnée -->
    <noData>
        <band height="40" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Aucune sortie pour usage]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>

