# Copiez ce fichier vers application-dev-secrets.yml et renseignez vos clés.
# application-dev-secrets.yml est ignoré par git — ne jamais committer les secrets.
#
# OpenAI : https://platform.openai.com/api-keys
# WhatsApp : https://developers.facebook.com/apps → WhatsApp → API Setup

cmkerp:
  stock-intelligence:
    openai:
      enabled: true
      api-key: CHANGEZ-MOI
      model: gpt-4o-mini
      max-tokens: 4096
      max-products-per-category: 15
    whatsapp:
      enabled: false
      token: CHANGEZ-MOI
      phone-number-id: CHANGEZ-MOI
      verify-token: cmk-stock-verify
      allowed-numbers:
        - "243XXXXXXXXX"
