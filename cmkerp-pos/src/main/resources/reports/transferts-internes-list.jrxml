<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transferts-internes-list"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <parameter name="TITRE_RAPPORT" class="java.lang.String"/>
    <parameter name="PHARMACIE_NOM" class="java.lang.String"/>
    <parameter name="DATE_GENERATION" class="java.lang.String"/>
    <parameter name="TOTAL_TRANSFERTS" class="java.lang.Integer"/>

    <field name="transfertId" class="java.lang.Long"/>
    <field name="pharmacieSourceNom" class="java.lang.String"/>
    <field name="pharmacieDestinationNom" class="java.lang.String"/>
    <field name="statut" class="java.lang.String"/>
    <field name="dateCreation" class="java.lang.String"/>
    <field name="commentaire" class="java.lang.String"/>

    <title>
        <band height="60">
            <textField>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITRE_RAPPORT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="400" height="16"/>
                <textFieldExpression><![CDATA["Service: " + ($P{PHARMACIE_NOM} != null ? $P{PHARMACIE_NOM} : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="28" width="402" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Date: " + $P{DATE_GENERATION} + " | Total: " + $P{TOTAL_TRANSFERTS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement x="0" y="0" width="50" height="22"/><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="50" y="0" width="180" height="22"/><text><![CDATA[Source]]></text></staticText>
            <staticText><reportElement x="230" y="0" width="180" height="22"/><text><![CDATA[Destination]]></text></staticText>
            <staticText><reportElement x="410" y="0" width="90" height="22"/><text><![CDATA[Statut]]></text></staticText>
            <staticText><reportElement x="500" y="0" width="110" height="22"/><text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="610" y="0" width="192" height="22"/><text><![CDATA[Commentaire]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="50" height="18"/><textFieldExpression><![CDATA[$F{transfertId}]]></textFieldExpression></textField>
            <textField><reportElement x="50" y="0" width="180" height="18"/><textFieldExpression><![CDATA[$F{pharmacieSourceNom}]]></textFieldExpression></textField>
            <textField><reportElement x="230" y="0" width="180" height="18"/><textFieldExpression><![CDATA[$F{pharmacieDestinationNom}]]></textFieldExpression></textField>
            <textField><reportElement x="410" y="0" width="90" height="18"/><textFieldExpression><![CDATA[$F{statut}]]></textFieldExpression></textField>
            <textField><reportElement x="500" y="0" width="110" height="18"/><textFieldExpression><![CDATA[$F{dateCreation}]]></textFieldExpression></textField>
            <textField><reportElement x="610" y="0" width="192" height="18"/><textFieldExpression><![CDATA[$F{commentaire} != null ? $F{commentaire} : ""]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
